# ============================================================
# GOOGLE SHEETS INTEGRATION - Environment Variables
# ============================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# IMPORTANT: Do NOT commit the .env file to Git!
# ============================================================

# --- Authentication (choose one option) ---
#
# OPTION 1: Service Account (recommended for CI/CD & automation)
# - Download the JSON credentials file from Google Cloud Console
# - Set an absolute or relative path to the file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# OPTION 2: API Key (public Sheets only, read-only)
# - Create an API Key at: https://console.cloud.google.com/apis/credentials
# - Note: API Key cannot write data, only read public Sheets
# GOOGLE_API_KEY=your-google-api-key-here

# --- Google Sheets Configuration ---

# Spreadsheet ID — Get it from the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# Example: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# Default sheet name (first tab if left empty)
GOOGLE_SHEET_NAME=Sheet1

# --- Output Configuration ---

# Default output directory for saved files (relative to project root)
OUTPUT_DIR=requirements/google_sheet

# Timezone for timestamp formatting in reports (e.g. Asia/Ho_Chi_Minh)
TIMEZONE=Asia/Ho_Chi_Minh

# --- Test Results Sheet Configuration ---
# Sheet name used for writing automation test results
RESULTS_SHEET_NAME=Test Results

# Header row number (row containing column names) - default: 1
RESULTS_HEADER_ROW=1
